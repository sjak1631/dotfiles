{{- $t := index .themes .rice.theme -}}
{{- $s := index .styles .rice.style -}}
# Generated by chezmoi from windows/dot_glzr/glazewm/config.yaml.tmpl
# Colors/gaps come from windows/.chezmoidata/rice.yaml (theme: {{ .rice.theme }}, style: {{ .rice.style }})
# Based on GlazeWM v3.10.1 sample config.

general:
  # Zebar + Flow Launcher replace the taskbar: keep it hidden while GlazeWM runs
  # (the watcher restores it by itself if GlazeWM goes away).
  # PowerShell goes through `conhost --headless`: with Windows Terminal as the default terminal,
  # -WindowStyle Hidden still shows a window (which GlazeWM would even tile).
  startup_commands:
    - 'shell-exec zebar'
    - 'shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/taskbar.ps1 watch'
  shutdown_commands:
    - 'shell-exec taskkill /IM zebar.exe /F'
    - 'shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/taskbar.ps1 show'
  config_reload_commands: []
  focus_follows_cursor: false
  toggle_workspace_on_refocus: false
  cursor_jump:
    enabled: true
    trigger: 'monitor_focus'
  hide_method: 'cloak'
  show_all_in_taskbar: false

gaps:
  scale_with_dpi: true
  inner_gap: '{{ $s.gap }}px'
  outer_gap:
    # The Zebar bar reserves its own space (dockToEdge), only on the monitor it is shown on
    top: '{{ $s.outer }}px'
    right: '{{ $s.outer }}px'
    bottom: '{{ $s.outer }}px'
    left: '{{ $s.outer }}px'

window_effects:
  focused_window:
    border:
      enabled: true
      color: '{{ $t.accent }}'
    hide_title_bar:
      enabled: false
    corner_style:
      enabled: true
      style: '{{ $s.corner }}'
    transparency:
      enabled: false
      opacity: '95%'
  other_windows:
    border:
      enabled: true
      color: '{{ $t.surface }}'
    hide_title_bar:
      enabled: false
    corner_style:
      enabled: true
      style: '{{ $s.corner }}'
    transparency:
      enabled: false
      opacity: '0%'

window_behavior:
  initial_state: 'tiling'
  state_defaults:
    floating:
      centered: true
      shown_on_top: false
    fullscreen:
      maximized: false
      shown_on_top: false

workspaces:
{{- if eq .machine "desktop" }}
  # Main monitor: 1-9, side monitor: 0. GlazeWM numbers monitors from the left: the portrait
  # side monitor (left) is 0, the main one 1. keep_alive: each monitor always shows its own
  # workspace, even when empty
  - name: '1'
    bind_to_monitor: 1
    keep_alive: true
  - name: '2'
    bind_to_monitor: 1
  - name: '3'
    bind_to_monitor: 1
  - name: '4'
    bind_to_monitor: 1
  - name: '5'
    bind_to_monitor: 1
  - name: '6'
    bind_to_monitor: 1
  - name: '7'
    bind_to_monitor: 1
  - name: '8'
    bind_to_monitor: 1
  - name: '9'
    bind_to_monitor: 1
  - name: '0'
    bind_to_monitor: 0
    keep_alive: true
{{- else }}
  - name: '1'
  - name: '2'
  - name: '3'
  - name: '4'
  - name: '5'
  - name: '6'
  - name: '7'
  - name: '8'
  - name: '9'
  - name: '0'
{{- end }}

window_rules:
  # Kdenlive's window (its welcome screen first, then the editor) never appears when GlazeWM tiles
  # it on creation; floating works (alt+t tiles it afterwards)
  - commands: ['set-floating']
    match:
      - window_process: { equals: 'kdenlive' }

  # Zen restores its last window size/position on startup after GlazeWM has tiled it (overlapping
  # the other windows); re-apply the layout shortly after it appears
  - commands: ['shell-exec conhost.exe --headless cmd.exe /c %USERPROFILE%/.local/bin/glazewm-settle.cmd']
    on: ['manage']
    match:
      - window_process: { equals: 'zen' }

  - commands: ['ignore']
    match:
      # Ignores any Zebar windows.
      - window_process: { equals: 'zebar' }

      # Ignores picture-in-picture windows for browsers.
      - window_title: { regex: '[Pp]icture.in.[Pp]icture' }
        window_class: { regex: 'Chrome_WidgetWin_1|MozillaDialogClass' }

      # Runs elevated, so GlazeWM can't manage it anyway.
      - window_process: { equals: 'LittleBigMouse.Ui.Avalonia' }

      # Ignore rules for various 3rd-party apps.
      - window_process: { equals: 'PowerToys' }
        window_class: { regex: 'HwndWrapper\[PowerToys\.PowerAccent.*?\]' }
      - window_title: { equals: 'Command Palette' }
        window_class: { equals: 'WinUIDesktopWin32WindowClass' }
      - window_process: { equals: 'PowerToys' }
        window_title: { regex: '.*? - Peek' }
      - window_process: { equals: 'Lively' }
        window_class: { regex: 'HwndWrapper' }
      - window_process: { equals: 'EXCEL' }
        window_class: { not_regex: 'XLMAIN' }
      - window_process: { equals: 'WINWORD' }
        window_class: { not_regex: 'OpusApp' }
      - window_process: { equals: 'POWERPNT' }
        window_class: { not_regex: 'PPTFrameClass' }

binding_modes:
  # When enabled, the focused window can be resized via arrow keys or HJKL.
  - name: 'resize'
    keybindings:
      - commands: ['resize --width -2%']
        bindings: ['h', 'left']
      - commands: ['resize --width +2%']
        bindings: ['l', 'right']
      - commands: ['resize --height +2%']
        bindings: ['k', 'up']
      - commands: ['resize --height -2%']
        bindings: ['j', 'down']
      - commands: ['wm-disable-binding-mode --name resize']
        bindings: ['escape', 'enter']

keybindings:
  # Shift focus in a given direction.
  - commands: ['focus --direction left']
    bindings: ['alt+h', 'alt+left']
  - commands: ['focus --direction right']
    bindings: ['alt+l', 'alt+right']
  - commands: ['focus --direction up']
    bindings: ['alt+k', 'alt+up']
  - commands: ['focus --direction down']
    bindings: ['alt+j', 'alt+down']

  # Move focused window in a given direction.
  - commands: ['move --direction left']
    bindings: ['alt+shift+h', 'alt+shift+left']
  - commands: ['move --direction right']
    bindings: ['alt+shift+l', 'alt+shift+right']
  - commands: ['move --direction up']
    bindings: ['alt+shift+k', 'alt+shift+up']
  - commands: ['move --direction down']
    bindings: ['alt+shift+j', 'alt+shift+down']

  # Resize: alt+r, then hjkl / arrows (alt+u/i/o/p are workspaces, see below)
  - commands: ['wm-enable-binding-mode --name resize']
    bindings: ['alt+r']

  # Disables window management and all other keybindings until alt+shift+z
  # is pressed again.
  - commands: ['wm-toggle-pause']
    bindings: ['alt+shift+z']

  - commands: ['toggle-tiling-direction']
    bindings: ['alt+v']
  # (alt+space = wm-cycle-focus in the sample config; left to Flow Launcher)
  - commands: ['toggle-floating --centered']
    bindings: ['alt+shift+space']
  - commands: ['toggle-tiling']
    bindings: ['alt+t']
  - commands: ['toggle-fullscreen']
    bindings: ['alt+f']
  # (alt+m is workspace 7, see below)
  - commands: ['toggle-minimized']
    bindings: ['alt+x']
  - commands: ['close']
    bindings: ['alt+shift+q']
  - commands: ['wm-exit']
    bindings: ['alt+shift+e']
  - commands: ['wm-reload-config']
    bindings: ['alt+shift+r']
  - commands: ['wm-redraw']
    bindings: ['alt+shift+w']

  # Terminal (full path: GlazeWM's PATH may predate the WezTerm install)
  - commands: ['shell-exec %ProgramFiles%/WezTerm/wezterm-gui.exe']
    bindings: ['alt+enter']
  # PowerShell in WezTerm's local domain (alt+enter opens WSL)
  - commands: ['shell-exec %ProgramFiles%/WezTerm/wezterm-gui.exe start --domain local']
    bindings: ['alt+shift+enter']

  # File manager (Explorer for now; yazi lives in the terminal as `y`)
  - commands: ['shell-exec explorer.exe']
    bindings: ['alt+e']

  # Focus the next/previous active workspace defined in `workspaces` config.
  - commands: ['focus --next-active-workspace']
    bindings: ['alt+s']
  - commands: ['focus --prev-active-workspace']
    bindings: ['alt+a']
  - commands: ['focus --recent-workspace']
    bindings: ['alt+d']

  # Workspaces 1-9, 0 by number or by right-hand letter (y u i o p / n m , . /): the roBa split
  # keyboard has its digits on a layer under the left hand, the same hand as Alt
  - commands: ['focus --workspace 1']
    bindings: ['alt+1', 'alt+y']
  - commands: ['focus --workspace 2']
    bindings: ['alt+2', 'alt+u']
  - commands: ['focus --workspace 3']
    bindings: ['alt+3', 'alt+i']
  - commands: ['focus --workspace 4']
    bindings: ['alt+4', 'alt+o']
  - commands: ['focus --workspace 5']
    bindings: ['alt+5', 'alt+p']
  - commands: ['focus --workspace 6']
    bindings: ['alt+6', 'alt+n']
  - commands: ['focus --workspace 7']
    bindings: ['alt+7', 'alt+m']
  - commands: ['focus --workspace 8']
    bindings: ['alt+8', 'alt+oem_comma']
  - commands: ['focus --workspace 9']
    bindings: ['alt+9', 'alt+oem_period']
  - commands: ['focus --workspace 0']
    bindings: ['alt+0', 'alt+oem_question']

  # Move the focused window's parent workspace to a monitor in a given direction.
  - commands: ['move-workspace --direction left']
    bindings: ['alt+shift+a']
  - commands: ['move-workspace --direction right']
    bindings: ['alt+shift+f']
  - commands: ['move-workspace --direction up']
    bindings: ['alt+shift+d']
  - commands: ['move-workspace --direction down']
    bindings: ['alt+shift+s']

  # Move focused window to a workspace defined in `workspaces` config.
  - commands: ['move --workspace 1', 'focus --workspace 1']
    bindings: ['alt+shift+1', 'alt+shift+y']
  - commands: ['move --workspace 2', 'focus --workspace 2']
    bindings: ['alt+shift+2', 'alt+shift+u']
  - commands: ['move --workspace 3', 'focus --workspace 3']
    bindings: ['alt+shift+3', 'alt+shift+i']
  - commands: ['move --workspace 4', 'focus --workspace 4']
    bindings: ['alt+shift+4', 'alt+shift+o']
  - commands: ['move --workspace 5', 'focus --workspace 5']
    bindings: ['alt+shift+5', 'alt+shift+p']
  - commands: ['move --workspace 6', 'focus --workspace 6']
    bindings: ['alt+shift+6', 'alt+shift+n']
  - commands: ['move --workspace 7', 'focus --workspace 7']
    bindings: ['alt+shift+7', 'alt+shift+m']
  - commands: ['move --workspace 8', 'focus --workspace 8']
    bindings: ['alt+shift+8', 'alt+shift+oem_comma']
  - commands: ['move --workspace 9', 'focus --workspace 9']
    bindings: ['alt+shift+9', 'alt+shift+oem_period']
  - commands: ['move --workspace 0', 'focus --workspace 0']
    bindings: ['alt+shift+0', 'alt+shift+oem_question']

  # Swap the focused workspace with workspace <n>, contents and layout included (ws-swap.ps1)
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 1']
    bindings: ['alt+ctrl+1', 'alt+ctrl+y']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 2']
    bindings: ['alt+ctrl+2', 'alt+ctrl+u']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 3']
    bindings: ['alt+ctrl+3', 'alt+ctrl+i']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 4']
    bindings: ['alt+ctrl+4', 'alt+ctrl+o']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 5']
    bindings: ['alt+ctrl+5', 'alt+ctrl+p']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 6']
    bindings: ['alt+ctrl+6', 'alt+ctrl+n']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 7']
    bindings: ['alt+ctrl+7', 'alt+ctrl+m']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 8']
    bindings: ['alt+ctrl+8', 'alt+ctrl+oem_comma']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 9']
    bindings: ['alt+ctrl+9', 'alt+ctrl+oem_period']
  - commands: ['shell-exec conhost.exe --headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%/.local/bin/ws-swap.ps1 0']
    bindings: ['alt+ctrl+0', 'alt+ctrl+oem_question']
