{{- $s := index .styles .rice.style -}}
{{- /* Exact argument lists panel.js passes (runScript / shellSpawn), anchored so nothing else
       (e.g. -Command) can ride along. Must match BIN in paths.js. */ -}}
{{- $run := printf "^-NoProfile -ExecutionPolicy Bypass -File %s/\\.local/bin/" (regexQuoteMeta .chezmoi.homeDir) -}}
{{- define "preset" -}}
        {
          "name": "{{ .name }}",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "{{ .height }}px",
          "monitorSelection": { "type": "{{ .name }}" },
          "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
        }
{{- end -}}
{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "dotfiles",
  "version": "0.1.0",
  "description": "Status bar for GlazeWM, managed by chezmoi (sjak1631/dotfiles).",
  "tags": ["topbar", "glazewm"],
  "previewImages": [],
  "repositoryUrl": "https://github.com/sjak1631/dotfiles",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js"],
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": { "shellCommands": [] },
      "presets": [
{{ template "preset" (dict "name" "primary" "height" (add $s.bar_margin $s.bar_height)) }},
{{ template "preset" (dict "name" "secondary" "height" (add $s.bar_margin $s.bar_height)) }}
      ]
      {{- /* settings.json only starts "primary"; "secondary" is kept for a bar on the side monitor */}}
    },
    {
      "name": "panel",
      "htmlPath": "./panel.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js"],
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": {
        "shellCommands": [
          { "program": "powershell", "argsRegex": {{ print $run "power\\.ps1 (lock|sleep|signout|restart|shutdown)$" | toJson }} },
          { "program": "powershell", "argsRegex": {{ print $run "bluetooth\\.ps1 (status|on|off|settings)$" | toJson }} },
          { "program": "powershell", "argsRegex": {{ print $run "clickwatch\\.ps1$" | toJson }} }
        ]
      },
      "presets": [
        {
          "name": "hidden",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "300px",
          "height": "300px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        }
      ]
      {{- /* Drop-down panels: started hidden with Zebar, moved and shown by panel.js */}}
    }
  ]
}
