{{- $t := index .themes .rice.theme -}}
{{- $s := index .styles .rice.style -}}
/* Generated by chezmoi from windows/.chezmoidata/rice.yaml (theme: {{ .rice.theme }}, style: {{ .rice.style }}) */
:root {
  --style: {{ .rice.style }};
{{- range $k, $v := $t }}
  --{{ $k | replace "_" "-" }}: {{ $v }};
{{- end }}
  --font: '{{ .rice.font }}', 'Yu Gothic UI', monospace;
  --gap: {{ $s.gap }}px;
  --outer: {{ $s.outer }}px;
  --bar-height: {{ $s.bar_height }}px;
  --bar-margin: {{ $s.bar_margin }}px;
  --radius: {{ $s.radius }}px;
}
