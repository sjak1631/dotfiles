{{- $t := index .themes .rice.theme -}}
-- Generated by chezmoi from windows/.chezmoidata/rice.yaml (theme: {{ .rice.theme }}, style: {{ .rice.style }})
return {
  scheme = '{{ get .terminal_schemes .rice.theme | default "" }}',
  font = '{{ .rice.font }}',
  font_size = {{ if .hidpi }}10.5{{ else }}11.5{{ end }},
  opacity = {{ .rice.terminal_opacity }},
  colors = {
{{- range $k, $v := $t }}
    {{ $k }} = '{{ $v }}',
{{- end }}
  },
}
