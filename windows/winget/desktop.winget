# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Applied only when machine = "desktop".
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: littlebigmouse
      directives:
        description: Little Big Mouse (physical-size aware cursor across monitors)
        allowPrerelease: true
      settings:
        id: mgth.LittleBigMouse
        source: winget
    # --- Games (desktop only; HoYoPlay isn't on winget: run_after_78-hoyoplay.ps1.tmpl) ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: steam
      directives:
        description: Steam
        allowPrerelease: true
      settings:
        id: Valve.Steam
        source: winget
