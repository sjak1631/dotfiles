# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Applied on every machine.
properties:
  configurationVersion: 0.2.0
  resources:
    # --- Bootstrap tools ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives:
        description: Git
        allowPrerelease: true
      settings:
        id: Git.Git
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: gh
      directives:
        description: GitHub CLI
        allowPrerelease: true
      settings:
        id: GitHub.cli
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: chezmoi
      directives:
        description: chezmoi
        allowPrerelease: true
      settings:
        id: twpayne.chezmoi
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: gitleaks
      directives:
        description: gitleaks
        allowPrerelease: true
      settings:
        id: Gitleaks.Gitleaks
        source: winget

    # --- Apps ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: zen
      directives:
        description: Zen Browser
        allowPrerelease: true
      settings:
        id: Zen-Team.Zen-Browser
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: bitwarden
      directives:
        description: Bitwarden
        allowPrerelease: true
      settings:
        id: Bitwarden.Bitwarden
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: slack
      directives:
        description: Slack
        allowPrerelease: true
      settings:
        id: SlackTechnologies.Slack
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vesktop
      directives:
        description: Vesktop
        allowPrerelease: true
      settings:
        id: Vencord.Vesktop
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: steam
      directives:
        description: Steam
        allowPrerelease: true
      settings:
        id: Valve.Steam
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: spotify
      directives:
        description: Spotify
        allowPrerelease: true
      settings:
        id: Spotify.Spotify
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives:
        description: Visual Studio Code
        allowPrerelease: true
      settings:
        id: Microsoft.VisualStudioCode
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: kanata
      directives:
        description: kanata (key remapper)
        allowPrerelease: true
      settings:
        id: jtroo.kanata_gui
        source: winget

    # --- Ricing ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: glazewm
      directives:
        description: GlazeWM (tiling WM, installer bundles Zebar)
        allowPrerelease: true
      settings:
        id: glzr-io.glazewm
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: font-jetbrainsmono-nerd
      directives:
        description: JetBrainsMono Nerd Font
        allowPrerelease: true
      settings:
        id: DEVCOM.JetBrainsMonoNerdFont
        source: winget

    # --- Windows settings ---
    - resource: Microsoft.Windows.Developer/EnableDarkMode
      directives:
        description: Dark mode
        allowPrerelease: true
      settings:
        Ensure: Present
        RestartExplorer: true
    - resource: Microsoft.Windows.Developer/WindowsExplorer
      directives:
        description: Explorer - show file extensions and hidden files
        allowPrerelease: true
      settings:
        FileExtensions: Show
        HiddenFiles: Show
        RestartExplorer: true
