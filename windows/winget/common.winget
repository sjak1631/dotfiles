# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Applied on every machine.
properties:
  configurationVersion: 0.2.0
  resources:
    # --- Bootstrap tools ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives:
        description: Git
        allowPrerelease: true
      settings:
        id: Git.Git
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: gh
      directives:
        description: GitHub CLI
        allowPrerelease: true
      settings:
        id: GitHub.cli
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: chezmoi
      directives:
        description: chezmoi
        allowPrerelease: true
      settings:
        id: twpayne.chezmoi
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: gitleaks
      directives:
        description: gitleaks
        allowPrerelease: true
      settings:
        id: Gitleaks.Gitleaks
        source: winget

    # --- Apps ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: zen
      directives:
        description: Zen Browser
        allowPrerelease: true
      settings:
        id: Zen-Team.Zen-Browser
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: bitwarden
      directives:
        description: Bitwarden
        allowPrerelease: true
      settings:
        id: Bitwarden.Bitwarden
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: slack
      directives:
        description: Slack
        allowPrerelease: true
      settings:
        id: SlackTechnologies.Slack
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vesktop
      directives:
        description: Vesktop
        allowPrerelease: true
      settings:
        id: Vencord.Vesktop
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: spotify
      directives:
        description: Spotify
        allowPrerelease: true
      settings:
        id: Spotify.Spotify
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: spicetify
      directives:
        description: Spicetify (Spotify theming, see run_after_77-spicetify.ps1)
        allowPrerelease: true
      settings:
        id: Spicetify.Spicetify
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: zoom
      directives:
        description: Zoom
        allowPrerelease: true
      settings:
        id: Zoom.Zoom
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives:
        description: Visual Studio Code
        allowPrerelease: true
      settings:
        id: Microsoft.VisualStudioCode
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: kanata
      directives:
        description: kanata (key remapper; the Interception build, see run_after_19-interception.ps1)
        allowPrerelease: true
      settings:
        id: jtroo.kanata_gui
        source: winget

    # --- Ricing ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: glazewm
      directives:
        description: GlazeWM (tiling WM, installer bundles Zebar)
        allowPrerelease: true
      settings:
        id: glzr-io.glazewm
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wezterm
      directives:
        description: WezTerm (stable; the nightly package fails winget's hash check)
        allowPrerelease: true
      settings:
        id: wez.wezterm
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: flowlauncher
      directives:
        description: Flow Launcher (Alt+Space)
        allowPrerelease: true
      settings:
        id: Flow-Launcher.Flow-Launcher
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: font-jetbrainsmono-nerd
      directives:
        description: JetBrainsMono Nerd Font
        allowPrerelease: true
      settings:
        id: DEVCOM.JetBrainsMonoNerdFont
        source: winget

    # --- Terminal file manager (yazi) and the tools it uses for previews/search ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: yazi
      directives:
        description: yazi
        allowPrerelease: true
      settings:
        id: sxyazi.yazi
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: 7zip
      directives:
        description: 7-Zip (archive previews)
        allowPrerelease: true
      settings:
        id: 7zip.7zip
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: ffmpeg
      directives:
        description: FFmpeg (video thumbnails)
        allowPrerelease: true
      settings:
        id: Gyan.FFmpeg
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: poppler
      directives:
        description: Poppler (PDF previews)
        allowPrerelease: true
      settings:
        id: oschwartz10612.Poppler
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: jq
      directives:
        description: jq (JSON previews)
        allowPrerelease: true
      settings:
        id: jqlang.jq
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: fd
      directives:
        description: fd
        allowPrerelease: true
      settings:
        id: sharkdp.fd
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: ripgrep
      directives:
        description: ripgrep
        allowPrerelease: true
      settings:
        id: BurntSushi.ripgrep.MSVC
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: fzf
      directives:
        description: fzf
        allowPrerelease: true
      settings:
        id: junegunn.fzf
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: zoxide
      directives:
        description: zoxide
        allowPrerelease: true
      settings:
        id: ajeetdsouza.zoxide
        source: winget

    # --- Windows settings ---
    - resource: Microsoft.Windows.Developer/EnableDarkMode
      directives:
        description: Dark mode
        allowPrerelease: true
      settings:
        Ensure: Present
        RestartExplorer: true
    - resource: Microsoft.Windows.Developer/WindowsExplorer
      directives:
        description: Explorer - show file extensions and hidden files
        allowPrerelease: true
      settings:
        FileExtensions: Show
        HiddenFiles: Show
        RestartExplorer: true
