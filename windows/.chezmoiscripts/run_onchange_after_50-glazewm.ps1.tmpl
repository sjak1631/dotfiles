$ErrorActionPreference = 'Stop'

# Re-runs (reload GlazeWM, restart Zebar) when the rice changes:
# rice: {{ dict "rice" .rice "style" (index .styles .rice.style) "theme" (index .themes .rice.theme) | toJson | sha256sum }}
# glazewm: {{ include "dot_glzr/glazewm/config.yaml.tmpl" | sha256sum }}
# taskbar: {{ include "dot_local/bin/taskbar.ps1" | sha256sum }}
{{- $zebar := list "settings.json" "dotfiles/zpack.json.tmpl" "dotfiles/vars.css.tmpl" "dotfiles/bar.html" "dotfiles/bar.js" "dotfiles/style.css" "dotfiles/common.js" "dotfiles/paths.js.tmpl" "dotfiles/panel.html" "dotfiles/panel.css" "dotfiles/panel.js" }}
# bin: {{ list (include "dot_local/bin/power.ps1") (include "dot_local/bin/bluetooth.ps1") (include "dot_local/bin/clickwatch.ps1") | join "" | sha256sum }}
# zebar:{{ range $zebar }} {{ include (print "dot_glzr/zebar/" .) | sha256sum | trunc 12 }}{{ end }}

$dir = Join-Path $env:ProgramFiles 'glzr.io'
$wm = Join-Path $dir 'GlazeWM\glazewm.exe'
$cli = Join-Path $dir 'GlazeWM\cli\glazewm.exe'
$zebar = Join-Path $dir 'Zebar\zebar.exe'
if (-not (Test-Path $wm)) { Write-Host '==> skip GlazeWM (not installed)'; exit 0 }

# Start at logon (GlazeWM starts Zebar via startup_commands)
$lnk = Join-Path ([Environment]::GetFolderPath('Startup')) 'GlazeWM.lnk'
$sc = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)
$sc.TargetPath = $wm
$sc.WorkingDirectory = Split-Path $wm
$sc.Save()

if (Get-Process glazewm -ErrorAction SilentlyContinue) {
    & $cli command wm-reload-config | Out-Null
    Get-Process zebar -ErrorAction SilentlyContinue | Stop-Process -Force
    # Helpers spawned by Zebar inherit its server socket; a leftover one breaks the next Zebar
    Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" |
        Where-Object CommandLine -match '[\\/]\.local[\\/]bin[\\/]clickwatch\.ps1' |
        ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
    Start-Sleep 1
    Start-Process $zebar
    # startup_commands only run when GlazeWM starts, so (re)start the taskbar watcher here too
    Start-Process powershell -WindowStyle Hidden -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', (Join-Path $HOME '.local\bin\taskbar.ps1'), 'watch'
    Write-Host '==> GlazeWM config reloaded, Zebar restarted, taskbar watcher started'
} else {
    Start-Process $wm
    Write-Host '==> GlazeWM started'
}
