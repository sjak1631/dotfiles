{{- $t := index .themes .rice.theme -}}
$ErrorActionPreference = 'Stop'

# Builds the Flow Launcher wallpaper plugin (Wallpaper.cs -> Wallpaper.exe) and its icon.
# source: {{ include "AppData/Roaming/FlowLauncher/Plugins/Wallpaper/Wallpaper.cs" | sha256sum }}
# plugin.json: {{ include "AppData/Roaming/FlowLauncher/Plugins/Wallpaper/plugin.json" | sha256sum }}
# icon colors: {{ $t.accent }} {{ $t.bg }}

$flow = Join-Path $env:LOCALAPPDATA 'FlowLauncher\Flow.Launcher.exe'
$pluginDir = Join-Path $env:APPDATA 'FlowLauncher\Plugins\Wallpaper'

# The exe can't be replaced while Flow has it loaded/running; stop Flow without letting it save
Get-Process Flow.Launcher -ErrorAction SilentlyContinue | Stop-Process -Force
Start-Sleep 1

$src = Get-Content (Join-Path $pluginDir 'Wallpaper.cs') -Raw -Encoding UTF8
Add-Type -TypeDefinition $src -Language CSharp -OutputType ConsoleApplication `
    -OutputAssembly (Join-Path $pluginDir 'Wallpaper.exe') `
    -ReferencedAssemblies System.Drawing, System.Web.Extensions, System.Core
Write-Host '==> Flow wallpaper plugin built'

# Icon: a mountain on a rounded square in the theme colors
Add-Type -AssemblyName System.Drawing
$bmp = New-Object System.Drawing.Bitmap 64, 64
$g = [System.Drawing.Graphics]::FromImage($bmp)
$g.SmoothingMode = 'AntiAlias'
$path = New-Object System.Drawing.Drawing2D.GraphicsPath
$path.AddArc(0, 0, 20, 20, 180, 90); $path.AddArc(44, 0, 20, 20, 270, 90)
$path.AddArc(44, 44, 20, 20, 0, 90); $path.AddArc(0, 44, 20, 20, 90, 90); $path.CloseFigure()
$g.FillPath((New-Object System.Drawing.SolidBrush ([System.Drawing.ColorTranslator]::FromHtml('{{ $t.accent }}'))), $path)
$fg = New-Object System.Drawing.SolidBrush ([System.Drawing.ColorTranslator]::FromHtml('{{ $t.bg }}'))
$g.FillPolygon($fg, [System.Drawing.Point[]]@((New-Object System.Drawing.Point 10, 50), (New-Object System.Drawing.Point 26, 26), (New-Object System.Drawing.Point 36, 40), (New-Object System.Drawing.Point 42, 32), (New-Object System.Drawing.Point 54, 50)))
$g.FillEllipse($fg, 40, 12, 10, 10)
$bmp.Save((Join-Path $pluginDir 'icon.png'), [System.Drawing.Imaging.ImageFormat]::Png)
$g.Dispose(); $bmp.Dispose()

if (Test-Path $flow) { Start-Process $flow; Write-Host '==> Flow Launcher restarted' }
