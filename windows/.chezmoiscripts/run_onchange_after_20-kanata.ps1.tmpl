$ErrorActionPreference = 'Stop'

# Re-runs (and restarts kanata) when the config changes:
# kanata.kbd: {{ include "AppData/Roaming/kanata/kanata.kbd" | sha256sum }}

# The Interception build (run_after_19-interception.ps1): the default hook-based build sometimes
# lost key releases, leaving Ctrl stuck down
$exeName = 'kanata_windows_gui_wintercept_x64'
$pkgDir = Get-ChildItem (Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Packages') -Directory -Filter 'jtroo.kanata_gui_*' |
    Select-Object -First 1
if (-not $pkgDir) {
    Write-Host '==> skip kanata (not installed)'
    exit 0
}
$exe = Join-Path $pkgDir.FullName "$exeName.exe"

# Validate config before (re)starting
$cfg = Join-Path $env:APPDATA 'kanata\kanata.kbd'
& (Join-Path $pkgDir.FullName 'kanata_windows_tty_winIOv2_x64.exe') --cfg $cfg --check --quiet
if ($LASTEXITCODE -ne 0) { throw "kanata config check failed: $cfg" }

# Started at logon by the dotfiles-kanata task (run_onchange_after_80-autostart); older versions
# used a Startup shortcut
Remove-Item (Join-Path ([Environment]::GetFolderPath('Startup')) 'kanata.lnk') -ErrorAction SilentlyContinue

# Restart now to pick up the new config (and stop the old hook-based build if it still runs)
Get-Process 'kanata_windows_*' -ErrorAction SilentlyContinue | Stop-Process -Force

# The driver only works after the reboot that follows its install; until then kanata can't start
# (the logon task starts it after that reboot)
if ((Get-CimInstance Win32_SystemDriver -Filter "Name='keyboard'" -ErrorAction SilentlyContinue).State -ne 'Running') {
    Write-Host '==> kanata not started: the Interception driver is not active yet (reboot)'
    exit 0
}

# CapsLock can't be turned off by the user once kanata owns the key, so make sure it starts off
if ([Console]::CapsLock) {
    Add-Type -Namespace Win32 -Name Kbd -MemberDefinition '[DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte scan, uint flags, System.UIntPtr extra);'
    [Win32.Kbd]::keybd_event(0x14, 0x3A, 0, [UIntPtr]::Zero)  # VK_CAPITAL down
    [Win32.Kbd]::keybd_event(0x14, 0x3A, 2, [UIntPtr]::Zero)  # up
    Write-Host '==> CapsLock turned off'
}

# --port: the logon task (run_onchange_after_80-autostart) passes the same arguments
Start-Process $exe -ArgumentList '--cfg', "`"$cfg`"", '--port', '127.0.0.1:7313' -WorkingDirectory (Split-Path $cfg)
Write-Host '==> kanata (re)started'
