{{- /* chezmoi:modify-template */ -}}
{{- /*
  Flow Launcher rewrites Settings.json itself, so only the keys below are managed;
  everything else is left as Flow wrote it. Hotkey: Flow's default Alt+Space (GlazeWM leaves it
  free). The wallpaper plugin opens by typing "wp" (Plugins/Wallpaper).
*/ -}}
{{- $managed := dict
      "Hotkey" "Alt + Space"
      "CustomPluginHotkeys" (list)
      "Theme" "Rice"
      "ColorScheme" "Dark"
      "UseSound" false
      "StartFlowLauncherOnSystemStartup" true
      "HideOnStartup" true
      "ShowAtTopmost" true
      "AutoUpdates" false
-}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = .chezmoi.stdin | fromJson }}{{ end -}}
{{- $changed := false -}}
{{- range $k, $v := $managed }}{{ if ne (toJson (get $current $k)) (toJson $v) }}{{ $changed = true }}{{ end }}{{ end -}}
{{- if $changed -}}
{{ mergeOverwrite $current $managed | toPrettyJson }}
{{- else -}}
{{ .chezmoi.stdin }}
{{- end -}}
