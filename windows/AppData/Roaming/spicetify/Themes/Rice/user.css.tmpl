{{- $s := index .styles .rice.style -}}
/* Spicetify "Rice" theme: the colors are in color.ini; this only rounds the main panels to match
   the rice style ({{ .rice.style }}). Generated by chezmoi. */
:root {
    --rice-radius: {{ if eq $s.corner "square" }}4px{{ else }}12px{{ end }};
}

.Root__nav-bar,
.Root__main-view,
.Root__right-sidebar > * {
    border-radius: var(--rice-radius) !important;
}

/* No buttons on the right of the playback bar (now playing view, lyrics, queue, devices, volume,
   mini player, full screen). The empty area stays, so the controls stay centered */
.main-nowPlayingBar-right > * {
    display: none !important;
}

/* Never show the right sidebar (now playing view, queue, lyrics, devices): hide it and let the
   main view take its column */
.Root__top-container {
    grid-template-areas:
        "top-banner top-banner top-banner"
        "global-nav global-nav global-nav"
        "left-sidebar main-view main-view"
        "now-playing-bar now-playing-bar now-playing-bar" !important;
}
.Root__top-container > div:has(#Desktop_PanelContainer_Id) {
    display: none !important;
}

/* No What's New / Friend Activity / account buttons at the top right */
.main-globalNav-contentRight .main-actionButtons {
    display: none !important;
}

/* "Playing on <device>" bar under the playback bar: text on the left instead of the right */
.main-nowPlayingBar-container > .encore-bright-accent-set {
    justify-content: flex-start !important;
}
